[Unit]
Description=Publica o tráfico Meshtastic en directo de O Zulo
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/mesh-noroeste
EnvironmentFile=/etc/mesh-noroeste/mesh-noroeste.env
ExecStart=/srv/mesh-noroeste/.venv/bin/python -m mesh_noroeste.cli collect-ozulo-live --output /srv/mesh-noroeste/frontend/data
TimeoutStartSec=2min
UMask=0022

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

ReadWritePaths=/srv/mesh-noroeste/state
ReadWritePaths=/srv/mesh-noroeste/data
ReadWritePaths=/srv/mesh-noroeste/frontend/data
